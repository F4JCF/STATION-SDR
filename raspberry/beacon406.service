[Unit]
Description=Balises de detresse 406 MHz (decodage COSPAS-SARSAT, ecoute seule)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=BEACON406_PORT=5009
Environment=DEC406_DIR=/opt/dec406
Environment=BEACON406_GAIN=-1
Environment=BEACON406_PPM=0
ExecStart=/usr/bin/python3 /usr/local/bin/beacon406_api.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
